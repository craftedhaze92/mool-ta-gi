# 한국투자증권 OpenAPI (KIS) 자격증명
#
# 발급: https://apiportal.koreainvestment.com/ > 마이페이지 > API 신청
# 실제 값은 .env.local 에 넣는다. .env.local 은 커밋되지 않는다.
#
# 서버 전용이다. NEXT_PUBLIC_ 접두사를 붙이면 클라이언트 번들에 그대로 노출되므로 절대 붙이지 않는다.

KIS_APP_KEY=
KIS_APP_SECRET=

# 실전투자: https://openapi.koreainvestment.com:9443
# 모의투자: https://openapivts.koreainvestment.com:29443
# 포트 번호까지 반드시 포함해야 한다.
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
