# 한국투자증권 OpenAPI (KIS) 자격증명
#
# 발급: https://apiportal.koreainvestment.com/ > 마이페이지 > API 신청
# 실제 값은 .env.local 에 넣는다. .env.local 은 커밋되지 않는다.
#
# 서버 전용이다. NEXT_PUBLIC_ 접두사를 붙이면 클라이언트 번들에 그대로 노출되므로 절대 붙이지 않는다.

KIS_APP_KEY=
KIS_APP_SECRET=

# 실전투자: https://openapi.koreainvestment.com:9443
# 모의투자: https://openapivts.koreainvestment.com:29443
# 포트 번호까지 반드시 포함해야 한다.
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# KIS 토큰 공유 저장소 (Upstash for Redis, 선택)
#
# Vercel Marketplace에서 Upstash for Redis를 연결하면 배포 환경에 자동으로 주입된다.
# 비워 두면 인스턴스 로컬 캐시만 쓴다. 로컬에서도 배포와 같은 토큰을 쓰려면
# Upstash 콘솔의 REST URL·토큰을 여기에 직접 넣는다 (따로 발급하면 배포의 토큰이 무효화된다).
# `vercel env pull`로는 받을 수 없다: KV 변수는 Sensitive라 Development 환경에 없고,
# 이 명령은 .env.local을 통째로 덮어써 KIS_* 값까지 지운다.
KV_REST_API_URL=
KV_REST_API_TOKEN=
